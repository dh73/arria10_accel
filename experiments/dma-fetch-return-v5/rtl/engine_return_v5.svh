// SPDX-License-Identifier: BSD-3-Clause
// The descriptor FIFO, tag record, header pipe, command FIFO and active command
// each own a complete immutable copy. A reused tag cannot change an older
// command's identity. ReturnBase is the admitted request's destination, not a
// completion-order counter. The containing route derives the effective address
// and ordinal from this base and each accepted native burst beat.
always_comb begin
  v5_admit_meta.epoch = FetchEpoch_i;
  v5_admit_meta.token = FetchBindToken_o;
  v5_admit_meta.base = RdDmaRxData_i[127:64];
  v5_admit_meta.count = RdDmaRxData_i[153] ? RdDmaRxData_i[138:131] : 8'b0;
end
assign ReturnEpoch_o = v5_write_meta.epoch;
assign ReturnToken_o = v5_write_meta.token;
assign ReturnBase_o = v5_write_meta.base;
assign ReturnCount_o = v5_write_meta.count;

// Requests generated by this native engine use complete DWORD byte enables.
// A CplD must settle exactly the outstanding suffix of THAT request. ByteCount
// zero encodes 4096 bytes; the configured MRRS here is at most 512 bytes.
// Unsupported no-data/error completions still fail closed: no invented tag
// retirement, timeout or success is introduced for an unimplemented protocol.
always_comb begin
  v5_bad_completion_shape = 1'b0;
  if (!rx_fifo_empty && rx_sop && is_cpl_wd &&
      cpl_tag < 16 && v2_tag_live[cpl_tag[3:0]]) begin
    v5_bad_completion_shape = cpl_bytecount != {remain_dw,2'b00} ||
      last_cpl != (rx_dwlen == remain_dw) ||
      RxFifoDataq_i[47:45] != 3'b000 ||
      RxFifoDataq_i[44] || RxFifoDataq_i[14] ||
      rx_cpl_addr[7] ||
      rx_cpl_addr[6:0] != v5_tag_source[cpl_tag[3:0]][6:0];
  end
end

always_ff @(posedge Clk_i or negedge Rstn_i) begin
  if (!Rstn_i) begin
    v5_current_meta <= '0; v5_cpl_meta <= '0;
    v5_cmd_meta_pipe <= '0; v5_write_meta <= '0;
    v5_guard_fault <= 1'b0;
    for (int k=0;k<16;k++) begin
      v5_tag_meta[k] <= '0; v5_tag_source[k] <= '0;
    end
  end else begin
    if (v2_start)
      v5_current_meta <= desc_head[RDDMA_RXDATA_WIDTH+4 +: V5_META_W];
    if (rd_header_state) begin
      v5_tag_meta[rd_tag_reg[3:0]] <= v5_current_meta;
      v5_tag_source[rd_tag_reg[3:0]] <= cur_src_addr_reg;
      if (v5_current_meta.token[11:8] != v2_current_slot ||
          v5_current_meta.token[7:0] != cur_desc_id_reg ||
          v5_current_meta.token[19:12] == 0)
        v5_guard_fault <= 1'b1;
    end
    if (latch_header) begin
      v5_cpl_meta <= v5_tag_meta[cpl_tag[3:0]];
      v5_tag_source[cpl_tag[3:0]] <=
        v5_tag_source[cpl_tag[3:0]] + {52'b0,rx_dwlen,2'b00};
      if (v5_tag_meta[cpl_tag[3:0]].token[11:8] !=
          v2_tag_owner[cpl_tag[3:0]]) v5_guard_fault <= 1'b1;
    end
    // This is the same two-register latency as cpl-slot -> cmd-slot-pipe.
    v5_cmd_meta_pipe <= v5_cpl_meta;
    if (avmmwr_cmd_fifo_rdreq) begin
      v5_write_meta <= avmmwr_cmd_q[75 +: V5_META_W];
      if (avmmwr_cmd_q[75+8+64+8 +: 4] != avmmwr_cmd_q[74:71])
        v5_guard_fault <= 1'b1;
    end
  end
end

// A combinational veto reaches the consumer before a simultaneous status
// commit. After the edge, retain the FIRST fault's cause and known identity.
// Token zero / tag ff deliberately means that no owner was established.
always_comb begin
  v5_fault_now = 1'b1;
  v5_fault_epoch_now = FetchEpoch_i;
  v5_fault_token_now = '0;
  v5_fault_reason_now = 8'h00;
  v5_fault_tag_now = 8'hff;
  if (v5_session_fault) v5_fault_reason_now = 8'h01;
  else if (ReturnRouteFault_i) begin
    v5_fault_reason_now = 8'h02;
    // This one-bit containment input may include a consumer fault while an
    // unrelated payload owns the write port. Its source retains the exact
    // identity; do not misattribute it to the currently active native burst.
  end else if (v2_bad_header) begin
    v5_fault_reason_now = 8'h03;
    v5_fault_tag_now = cpl_tag;
    if (cpl_tag < 16 && v2_tag_live[cpl_tag[3:0]]) begin
      v5_fault_epoch_now = v5_tag_meta[cpl_tag[3:0]].epoch;
      v5_fault_token_now = v5_tag_meta[cpl_tag[3:0]].token;
    end
  end else if (v2_guard_fault || v5_guard_fault)
    v5_fault_reason_now = 8'h04;
  else if (ContractFault_o) v5_fault_reason_now = 8'h05;
  else v5_fault_now = 1'b0;
end
assign ReturnFault_o = Rstn_i && (v5_fault_q || v5_fault_now);
assign ReturnFaultEpoch_o = v5_fault_q ? v5_fault_epoch_q : v5_fault_epoch_now;
assign ReturnFaultToken_o = v5_fault_q ? v5_fault_token_q : v5_fault_token_now;
assign ReturnFaultReason_o = v5_fault_q ? v5_fault_reason_q : v5_fault_reason_now;
assign ReturnFaultTag_o = v5_fault_q ? v5_fault_tag_q : v5_fault_tag_now;
always_ff @(posedge Clk_i or negedge Rstn_i) begin
  if (!Rstn_i) begin
    v5_fault_q <= 1'b0; v5_fault_epoch_q <= '0;
    v5_fault_token_q <= '0; v5_fault_reason_q <= '0; v5_fault_tag_q <= 8'hff;
  end else if (v5_fault_now && !v5_fault_q) begin
    v5_fault_q <= 1'b1; v5_fault_epoch_q <= v5_fault_epoch_now;
    v5_fault_token_q <= v5_fault_token_now;
    v5_fault_reason_q <= v5_fault_reason_now; v5_fault_tag_q <= v5_fault_tag_now;
  end
end

// synthesis translate_off
initial if ($bits(v5_return_meta_t) != V5_META_W)
  $fatal(1,"return metadata width mismatch");
assert property (@(posedge Clk_i) disable iff(!Rstn_i)
  RdDmaWrite_o && RdDmaWaitRequest_i |=> RdDmaWrite_o &&
  $stable({ReturnEpoch_o,ReturnToken_o,ReturnBase_o,ReturnCount_o}));
assert property (@(posedge Clk_i) disable iff(!Rstn_i)
  desc_fifo_wrreq |-> FetchEnable_i && !ReturnFault_o &&
  v5_admit_meta.token[11:8]==v2_alloc_slot && v5_admit_meta.token[19:12]!=0);
assert property (@(posedge Clk_i) disable iff(!Rstn_i)
  rd_header_state |-> v5_current_meta.token[11:8]==v2_current_slot);
assert property (@(posedge Clk_i) disable iff(!Rstn_i)
  latch_header |-> v5_tag_meta[cpl_tag[3:0]].token[11:8]==v2_tag_owner[cpl_tag[3:0]]);
assert property (@(posedge Clk_i) disable iff(!Rstn_i)
  latch_header_reg2 |-> v5_cmd_meta_pipe.token[11:8]==v2_cmd_slot_pipe);
assert property (@(posedge Clk_i) disable iff(!Rstn_i)
  RdDmaWrite_o |-> ReturnToken_o[11:8]==v2_write_slot && ReturnToken_o[19:12]!=0);
assert property (@(posedge Clk_i) disable iff(!Rstn_i)
  v5_fault_q |=> v5_fault_q &&
  $stable({v5_fault_epoch_q,v5_fault_token_q,v5_fault_reason_q,v5_fault_tag_q}));
// synthesis translate_on
